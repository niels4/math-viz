{
  "name": "math-viz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#generated/*": "./generated/*",
    "#test": "./src/test/includes.tsx"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "generate": "node ./scripts/generate-routes.script.ts",
    "format": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc -b --noEmit",
    "test:watch": "vitest --coverage --project jsdom",
    "test:run": "npm run test:watch -- --run",
    "test:ui": "npm run test:watch -- --ui",
    "test:watch:browser": "vitest --project browser --coverage",
    "test:run:browser": "npm run test:watch:browser -- --run",
    "test": "npm run lint && npm run typecheck && npm run test:run",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "classnames": "2.5.1",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "gsap": "3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "~7.0.2",
    "unplugin-typed-css-modules": "1.1.0",
    "vite": "8.3.1",
    "vite-plugin-websocket-text-relay": "^1.1.1",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "overrides": {
    "typed-scss-modules": {
      "esbuild": "$esbuild"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
